# MongoDB Atlas Connection String (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jamila?retryWrites=true&w=majority

# JWT Secret Key — Must be at least 32 random characters (Required)
JWT_SECRET=replace_with_a_strong_32_plus_char_random_secret

# Cloudinary Configuration (Required for product image uploads in production / Vercel)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional One-Time Initial Admin Seeding (Only used by POST /api/seed when authorized)
SEED_SECRET=replace_with_optional_seed_secret
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_strong_initial_admin_password
